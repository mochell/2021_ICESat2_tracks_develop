# Snakefile for analysis_db_claude
#
#   cd analysis_db_claude
#   snakemake --cores 1 discover --config batch=SH_dev_small          # B00: tracks.csv (once per batch)
#   snakemake --cores 16 --resources heavy=4 sliderule=1 thredds=2 \
#             --keep-going --config batch=SH_dev_small                 # everything up to C01
#   snakemake ... --until B04                                          # stop after a stage
#   snakemake ... -R B04                                               # rerun a stage (+downstream) after editing it
#   snakemake ... -f work/<batch>/status/B04/<ID>.ok                   # one track, one stage
#   snakemake ... -n                                          # dry run: what and why
#
# Every per-track job writes work/<batch>/status/<stage>/<ID>.json and, for success/skip/blocked,
# the sentinel <ID>.ok that the rules below use as their output. A failed job leaves the json
# (with the traceback) and no .ok, so it is retried on the next run.
import os
import sys
import pandas as pd

sys.path.insert(0, workflow.basedir)
from pipeline_config import paths_for
from pipeline_params import materialize, load_batch
from pipeline_status import read_status
from pipeline_dag import DEPS, ORDER_AFTER, SCRIPT, THREADS, THREADS_DEFAULT, RESOURCES, TRACK_STAGES

BATCH = config['batch']
P = paths_for(BATCH)
PY = sys.executable
SD = workflow.basedir
ENV = 'MPLBACKEND=Agg'

tracks_csv = P.batch_work + 'tracks.csv'
if os.path.exists(tracks_csv):
    _tr = pd.read_csv(tracks_csv)
    TRACKS = sorted(_tr[_tr.selected].ID.unique().tolist())
    CHUNKS = sorted(_tr[_tr.selected].chunk.unique().tolist())
    IDS_OF_CHUNK = {c: sorted(_tr[(_tr.chunk == c) & _tr.selected].ID.unique().tolist()) for c in CHUNKS}
    PRM = materialize(BATCH)
else:
    TRACKS, CHUNKS, IDS_OF_CHUNK, PRM = [], [], {}, {}

wildcard_constraints:
    ID = r'[NS]H_\d{8}_\d{8}',
    chunk = r'\d+'


def ok(stage, ID='{ID}'):
    return P.status + f'{stage}/{ID}.ok'


def launcher_log(stage, ID='{ID}'):
    return P.logs + f'{stage}/{ID}.launcher.log'


# ------------------------------------------------------------------ targets
rule all:
    input:
        expand(ok('C01'), ID=TRACKS),
        expand(ok('B03'), ID=TRACKS),      # figures only, nothing depends on it
        P.batch_work + 'C01_database/index.csv' if TRACKS else [],

for _s in TRACK_STAGES:
    rule:
        name: f'{_s}_all'
        input: expand(ok(_s), ID=TRACKS)

rule B01_all:
    input:
        expand(ok('B01'), ID=TRACKS)


# ------------------------------------------------------------------ B00 discover (run explicitly)
rule discover:
    output:
        tracks_csv,
        P.batch_work + 'rgt_start_points.geojson',
    shell:
        f'{ENV} {PY} {SD}/stages/B00_discover.py {BATCH}'


# ------------------------------------------------------------------ B01: one SlideRule job per chunk
rule B01:
    input:
        script = SD + '/' + SCRIPT['B01'],
        prm = lambda wc: PRM['B01'],
        tracks = tracks_csv,
    output:
        P.status + 'B01/chunk{chunk}.ok'
    log:
        P.logs + 'B01/chunk{chunk}.launcher.log'
    threads: 1
    resources:
        sliderule = 1, heavy = 1
    shell:
        f'{ENV} OMP_NUM_THREADS={{threads}} {PY} {{input.script}} {BATCH} {{wildcards.chunk}} > {{log}} 2>&1'


def chunk_of(ID):
    for c, ids in IDS_OF_CHUNK.items():
        if ID in ids:
            return c
    raise ValueError(f'{ID} not in tracks.csv')

# per-track B01 sentinel: the chunk job writes status/B01/<ID>.json for every expected track;
# this rule turns a usable record (success/skip/blocked) into the .ok Snakemake target
# (Snakemake removes the output before running the rule, so the .ok cannot simply be pre-existing)
rule B01_track:
    input:
        lambda wc: P.status + f'B01/chunk{chunk_of(wc.ID)}.ok'
    output:
        ok('B01')
    run:
        st = read_status(BATCH, 'B01', wildcards.ID)
        if st and st['status'] in ('success', 'skip', 'blocked'):
            open(output[0], 'w').close()
        else:
            raise ValueError(f"B01 {wildcards.ID}: status {st['status'] if st else 'missing'} "
                                f"({(st or {}).get('reason') or (st or {}).get('error_msg') or ''}); rerun with -R B01")


# ------------------------------------------------------------------ per-track stages
def make_track_rule(stage):
    rule:
        name: stage
        input:
            script = SD + '/' + SCRIPT[stage],
            prm = lambda wc: PRM[stage],
            up = [ok(d) for d in DEPS[stage] + ORDER_AFTER.get(stage, [])],   # .ok exists for any final status
        output:
            ok(stage)
        log:
            launcher_log(stage)
        threads: THREADS.get(stage, THREADS_DEFAULT)
        resources:
            **RESOURCES.get(stage, {})
        shell:
            f'{ENV} OMP_NUM_THREADS={{threads}} OPENBLAS_NUM_THREADS={{threads}} MKL_NUM_THREADS={{threads}} '
            f'{PY} {{input.script}} {{wildcards.ID}} {BATCH} > {{log}} 2>&1'

for _s in TRACK_STAGES:
    make_track_rule(_s)


# ------------------------------------------------------------------ batch-level products
rule index:
    input:
        expand(ok('C01'), ID=TRACKS)
    output:
        P.batch_work + 'C01_database/index.csv'
    shell:
        f'{ENV} {PY} {SD}/stages/C01_index.py {BATCH}'

rule gallery:
    shell:
        f'{ENV} {PY} {SD}/gallery.py {BATCH}'

onsuccess:
    shell(f'{ENV} {PY} {SD}/gallery.py {BATCH} || true')

onerror:
    shell(f'{ENV} {PY} {SD}/gallery.py {BATCH} || true')
